
# WhatsApp (CallMeBot - free)
# Get key: https://api.callmebot.com/whatsapp/
WHATSAPP_CALLMEBOT_KEY=
WHATSAPP_CALLMEBOT_TO=
# ===== OTP 長者免密碼登入（工單十三）=====
# 生產必須有其中一個通道，否則 /api/auth/otp/send 會回 503
# 1) Twilio SMS（推薦，需購買香港 sender）
#    Alphanumeric Sender 例如 ZenPass，或 +852 長碼
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
#    舊名兼容：TWILIO_SMS_FROM
TWILIO_SMS_FROM=
# 2) Twilio WhatsApp（SMS 失敗／超時 5 秒自動 fallback）
TWILIO_WHATSAPP_FROM=
#    保留舊開關；現時 SMS 失敗會自動 fallback，毋須設定
TWILIO_OTP_CHANNEL=
#    SMS 等待上限（毫秒），預設 5000
SMS_FALLBACK_MS=5000
# 3) Meta WhatsApp Cloud（WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID；建議用已核准驗證碼模板）
WHATSAPP_OTP_TEMPLATE=
# 試行／測試號碼：生產環境都回傳固定沙盒碼（逗號分隔 8 位電話）
OTP_TEST_PHONES=
OTP_SANDBOX_CODE=123456
# 推薦獎賞每月上限（預設 4）
REFERRAL_MONTHLY_CAP=4
