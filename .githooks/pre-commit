#!/bin/sh
# ZenPass 禪流 — Pre-commit Hook
# 自動執行測試，失敗則 block commit
#
# 安裝：git config core.hooksPath .githooks

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 執行命令；若因 rate limit（429）而失敗，自動等 45 秒重試（最多 3 次）
# （測試會打 localhost:3001，連續跑多輪會撞限流 → 唔應該因此擋 commit）
run_retry() {
  _attempt=1
  while [ "$_attempt" -le 3 ]; do
    if "$@" >/tmp/zenpass-hook-test.log 2>&1; then
      cat /tmp/zenpass-hook-test.log
      return 0
    fi
    cat /tmp/zenpass-hook-test.log
    if [ "$_attempt" -lt 3 ] && grep -qE "429|Too Many Requests|rate limit|次數過多|請 1 分鐘" /tmp/zenpass-hook-test.log; then
      echo "${YELLOW}⚠️  偵測到 rate limit (429) — 等 45 秒重試（第 $((_attempt+1))/3 次）...${NC}"
      sleep 45
      _attempt=$((_attempt+1))
      continue
    fi
    return 1
  done
}

echo ""
echo "🧪 ZenPass Pre-commit Hook: Running tests..."
echo ""

# 檢查是否有 staged 的檔案跟 backend 有關
STAGED_FILES=$(git diff --cached --name-only)
HAS_BACKEND_CHANGES=$(echo "$STAGED_FILES" | grep -c "^backend/" || true)
HAS_FRONTEND_CHANGES=$(echo "$STAGED_FILES" | grep -c "^frontend" || true)

if [ "$HAS_BACKEND_CHANGES" -eq 0 ] && [ "$HAS_FRONTEND_CHANGES" -eq 0 ]; then
  echo "${YELLOW}⚠️  沒有 backend 或 frontend 改動，跳過測試${NC}"
  echo ""
  exit 0
fi

# ---- Backend Tests ----
if [ "$HAS_BACKEND_CHANGES" -gt 0 ]; then
  echo "${YELLOW}📦 Backend 有改動，執行 backend tests...${NC}"

  # 檢查 node_modules 是否存在
  if [ ! -d "backend/node_modules" ]; then
    echo "${YELLOW}📦 安裝 backend dependencies...${NC}"
    (cd backend && npm install) || {
      echo "${RED}❌ npm install 失敗${NC}"
      exit 1
    }
  fi

  # 執行所有 test（若 package.json 有 test script）
  if grep -q '"test"' backend/package.json 2>/dev/null; then
    run_retry sh -c 'cd backend && npm test' || {
      echo ""
      echo "${RED}❌ Backend tests FAILED — commit 被阻止${NC}"
      echo "${YELLOW}請修正測試錯誤後再 commit${NC}"
      echo ""
      exit 1
    }
    echo "${GREEN}✅ Backend tests passed${NC}"
  else
    echo "${YELLOW}⚠️  backend/package.json 未有 test script，跳過${NC}"
  fi

  # 如果有 test 目錄，直接執行指定 test files
  if [ -d "backend/tests" ]; then
    echo "${YELLOW}📋 執行 backend/tests/ 目錄下的測試...${NC}"
    # 跳過 npm test 已跑嘅檔（避免重複打 server 導致限流假失敗）
    TEST_FILES=$(find backend/tests -name "*.js" 2>/dev/null | grep -v node_modules | grep -vE "test-(enrolled-count|points-waiver|improvements)\.js$")
    if [ -n "$TEST_FILES" ]; then
      for tf in $TEST_FILES; do
        echo "   測試: $tf"
        run_retry node "$tf" || {
          echo ""
          echo "${RED}❌ 測試失敗: $tf${NC}"
          echo "${RED}❌ Commit 被阻止 — 請修正測試錯誤後再 commit${NC}"
          echo ""
          exit 1
        }
      done
    fi
    echo "${GREEN}✅ All backend tests passed${NC}"
  fi
fi

# ---- Frontend Tests (check for basic issues) ----
if [ "$HAS_FRONTEND_CHANGES" -gt 0 ]; then
  echo "${YELLOW}🎨 Frontend 有改動，檢查 HTML 結構...${NC}"

  # 檢查改動的 HTML 檔案是否有基本錯誤
  for f in $(echo "$STAGED_FILES" | grep "\.html$" || true); do
    if [ -f "$f" ]; then
      # 檢查是否有未閉合的 <script> 或 <style> 標籤
      SCRIPT_OPEN=$(grep -c '<script' "$f" 2>/dev/null || true)
      SCRIPT_CLOSE=$(grep -c '</script>' "$f" 2>/dev/null || true)
      if [ "$SCRIPT_OPEN" -ne "$SCRIPT_CLOSE" ]; then
        echo "${RED}❌ $f: <script> 標籤數量不匹配 (open=$SCRIPT_OPEN, close=$SCRIPT_CLOSE)${NC}"
        exit 1
      fi

      STYLE_OPEN=$(grep -c '<style' "$f" 2>/dev/null || true)
      STYLE_CLOSE=$(grep -c '</style>' "$f" 2>/dev/null || true)
      if [ "$STYLE_OPEN" -ne "$STYLE_CLOSE" ]; then
        echo "${RED}❌ $f: <style> 標籤數量不匹配 (open=$STYLE_OPEN, close=$STYLE_CLOSE)${NC}"
        exit 1
      fi

      echo "  ✅ $f — HTML 結構正常"
    fi
  done

  # 🧠 檢查 inline <script> 語法（一個 syntax error 就會搞死成頁，例如 admin.html 曾中招）
  HTML_FILES=$(echo "$STAGED_FILES" | grep -E "\.html$" || true)
  if [ -n "$HTML_FILES" ]; then
    echo "${YELLOW}🔎 檢查 inline <script> JS 語法...${NC}"
    python3 zenpass-tester/scripts/check-inline-js.py $HTML_FILES || {
      echo ""
      echo "${RED}❌ inline <script> 有 JS 語法錯誤 — commit 被阻止${NC}"
      echo "${YELLOW}請修正後再 commit${NC}"
      exit 1
    }
  fi

  # 🦶 自動統一 Footer：任何 frontend HTML 若無 footer-grad 就自動 inline
  FOOTER_SCRIPT="zenpass-tester/scripts/inline-footer.py"
  FOOTER_AUTO_FIX=0
  for f in $(echo "$STAGED_FILES" | grep "^frontend/.*\.html$" | grep -v assets/footer.html || true); do
    if [ -f "$f" ]; then
      if ! grep -q 'footer-grad' "$f" 2>/dev/null; then
        echo "  ${YELLOW}⚠️  $f 缺少統一 footer，自動注入...${NC}"
        FOOTER_AUTO_FIX=1
      fi
    fi
  done

  if [ "$FOOTER_AUTO_FIX" -gt 0 ]; then
    python3 "$FOOTER_SCRIPT" 2>&1 | sed 's/^/    /'
    # Re-stage the modified files
    for f in $(echo "$STAGED_FILES" | grep "^frontend/.*\.html$" | grep -v assets/footer.html || true); do
      if [ -f "$f" ]; then
        git add "$f"
      fi
    done
    echo "  ${GREEN}✅ Footer 已自動統一${NC}"
  fi

  echo "${GREEN}✅ Frontend checks passed${NC}"
fi

echo ""
echo "${GREEN}🎉 All checks passed! Commit 繼續進行。${NC}"
echo ""
